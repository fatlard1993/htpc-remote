{
	"name": "htpc-remote",
	"version": "2.0.0",
	"type": "module",
	"exports": {
		"./package.json": "./package.json",
		".": "./server/index.js"
	},
	"description": "BYOD htpc control",
	"author": "fatlard1993",
	"license": "ISC",
	"browserslist": [
		"last 1 version",
		"> 1%",
		"not dead",
		"not op_mini all"
	],
	"scripts": {
		"prepare": "bun run prepare:githooks && bun run build",
		"prepare:githooks": "[ -n \"$CI\" ] && exit 0 || (git config --local core.hooksPath .githooks || echo 'Cannot set core.hooksPath -- pre-commit checks will not run')",
		"build": "bun run build:clean && vbc-build",
		"build:clean": "rm -rf ./client/build/",
		"start": "NODE_ENV=production bun server/index.js",
		"dev": "NODE_ENV=development bun --hot server/index.js",
		"service:enable": "vbc-service enable --port 8793",
		"service:disable": "vbc-service disable",
		"service:reload": "vbc-service reload",
		"deploy": "bun run build && bun run service:reload",
		"test": "bun test",
		"lint": "bun --bun eslint",
		"lint:fix": "bun --bun eslint --fix",
		"format": "bun run lint:fix && bun --bun prettier --write .",
		"version": "npm version"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fatlard1993/htpc-remote.git"
	},
	"bugs": {
		"url": "https://github.com/fatlard1993/htpc-remote/issues"
	},
	"homepage": "https://github.com/fatlard1993/htpc-remote#readme",
	"dependencies": {
		"@jitsi/robotjs": "^0.6.24",
		"argi": "github:fatlard1993/argi#fcac703",
		"nanoid": "^6.0.0",
		"@vanilla-bean/components": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"bun-types": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsdoc": "^63.0.13",
		"eslint-plugin-spellcheck": "0.0.20",
		"eslint-plugin-testing-library": "^7.16.2",
		"eslint-plugin-write-good-comments": "^0.2.0",
		"globals": "^17.7.0",
		"prettier": "3.5.3"
	}
}
